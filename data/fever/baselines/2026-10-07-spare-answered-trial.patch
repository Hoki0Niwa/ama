diff --git a/fever/stock.h b/fever/stock.h
index c9fa3d6..3206973 100644
--- a/fever/stock.h
+++ b/fever/stock.h
@@ -96,6 +96,114 @@ inline Result evaluate(Field field, i32 want)
     return result;
 };
 
+// The longest chain one trigger of the board fires. `fired` gets the board with that trigger placed.
+inline i32 longest(Field field, Field* fired = nullptr)
+{
+    u8 heights[6];
+    field.get_heights(heights);
+
+    i32 best = 0;
+
+    for (i8 x = 0; x < 6; ++x) {
+        i32 drop_max = std::min(3, 12 - i32(heights[x]));
+
+        for (u8 p = 0; p < cell::COUNT - 1; ++p) {
+            auto plan = field;
+
+            for (i32 need = 1; need <= drop_max; ++need) {
+                plan.data[p].set_bit(x, heights[x] + need - 1);
+
+                if (plan.data[p].get_mask_group_4(x, heights[x]).get_count() < 4) {
+                    continue;
+                }
+
+                auto remain = plan;
+                i32 links = remain.pop_count();
+
+                if (links > best) {
+                    best = links;
+
+                    if (fired) {
+                        *fired = plan;
+                    }
+                }
+
+                break;
+            }
+        }
+    }
+
+    return best;
+};
+
+struct Spare
+{
+    i32 units = 0; // Links weighted as in Result
+    i32 links = 0;
+};
+
+// A trigger longer than this is a chain of its own, not something to offset with beside the main chain
+constexpr i32 SPARE_CHAIN = 2;
+
+// Spare stock: links the board pops, one small trigger after another, that leave its longest chain as
+// long as it is. This is what offsets nuisance while the main chain stays on the board.
+inline Spare spare(Field field, i32 want)
+{
+    Spare result;
+
+    const i32 keep = longest(field);
+
+    for (i32 round = 0; round < ROUNDS && result.links < want; ++round) {
+        u8 heights[6];
+        field.get_heights(heights);
+
+        i32 best_need = 4;
+        i32 best_links = 0;
+        Field best_remain;
+
+        for (i8 x = 0; x < 6; ++x) {
+            i32 drop_max = std::min(3, 12 - i32(heights[x]));
+
+            for (u8 p = 0; p < cell::COUNT - 1; ++p) {
+                auto plan = field;
+
+                for (i32 need = 1; need <= drop_max; ++need) {
+                    plan.data[p].set_bit(x, heights[x] + need - 1);
+
+                    if (plan.data[p].get_mask_group_4(x, heights[x]).get_count() < 4) {
+                        continue;
+                    }
+
+                    if (need < best_need) {
+                        auto remain = plan;
+                        i32 links = remain.pop_count();
+
+                        if (links <= SPARE_CHAIN && longest(remain) >= keep) {
+                            best_need = need;
+                            best_links = links;
+                            best_remain = remain;
+                        }
+                    }
+
+                    break;
+                }
+            }
+        }
+
+        if (best_links <= 0) {
+            break;
+        }
+
+        i32 taken = std::min(best_links, want - result.links);
+
+        result.links += taken;
+        result.units += taken * UNITS[best_need];
+        field = best_remain;
+    }
+
+    return result;
+};
+
 };
 
 };
